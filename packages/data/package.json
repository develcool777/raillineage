{
  "name": "@raillineage/data",
  "version": "0.0.0",
  "private": true,
  "license": "(MIT AND ODbL-1.0)",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "boundary": "node src/boundary/cli.ts",
    "summaries": "node src/summary/cli.ts",
    "test-unit": "vitest",
    "test-unit-ci": "vitest run",
    "test-bench": "vitest bench --run --reporter=verbose",
    "previews": "node src/preview/cli.ts"
  },
  "exports": {
    "./cities.json": "./cities/cities.json",
    "./preview.constants": "./src/preview/preview.constants.ts",
    "./city.utils": "./src/city.utils.ts"
  },
  "dependencies": {
    "@raillineage/core": "workspace:*",
    "@raillineage/network": "workspace:*",
    "@raillineage/schema": "workspace:*"
  },
  "devDependencies": {
    "@raillineage/renderer": "workspace:*",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "vitest": "^5.1.1"
  }
}
